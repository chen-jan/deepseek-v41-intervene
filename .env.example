# Copy to .env (gitignored) and fill in. Paths only: no secrets here. The server key lives in its own file
# ($DSV41_KEY_FILE, created by scripts/make_key.sh with mode 0600). Every script sources scripts/common.sh, which
# reads this file and stops with a clear message when a required variable is missing.

# --- required -----------------------------------------------------------------------------------------------------
# Work folder for the venv, caches, logs, arms files and captures. Needs ~30 GB plus captures; keep it off $HOME.
DSV41_ROOT=/path/to/work/dsv41
# The checkpoint (deepseek-ai/DeepSeek-V4.1-Flash-1017, 476 GiB). Fast local disk of the GPU node if you can.
DSV41_MODEL_DIR=/path/to/local/nvme/DeepSeek-V4.1-Flash-1017

# --- optional (defaults shown) -------------------------------------------------------------------------------------
# DSV41_VENV=$DSV41_ROOT/envs/vllm031           # built by scripts/build_env.sh
# DSV41_CACHE=$DSV41_ROOT/cache                 # pip/uv/triton/inductor/flashinfer/tilelang/HF/tmp caches
# HF_HOME=$DSV41_CACHE/hf
# DSV41_LOG_DIR=$DSV41_ROOT/logs                # server logs, bench results, gate folders, native floors
# DSV41_KEY_FILE=$DSV41_ROOT/.serve_key         # API key file (0600); never printed by any script or tool
# DSV41_ARMS_DIR=$DSV41_ROOT/arms               # arms files + LOADED_SHAS / GLOBAL_ARM state for the proxy
# DSV41_CAPTURE_DIR=$DSV41_ROOT/captures        # capture dumps; must be visible to the engine (node-local disk is best)
# DSV41_XCHECK_DIR=$DSV41_ROOT/xcheck           # vector captures the info gate saves for cross-engine checks
# DSV41_DATA_DIR=<repo>/data                    # test prompts from tools/build_data.py
# DSV41_SETUP_HOOK=/path/to/site_setup.sh       # sourced first, e.g. `module load cuda/13.0.1` and CC/CXX for JIT
# DSV41_FLASHINFER_WHEELS=/path/to/wheels       # offline hosts: folder with the flashinfer_jit_cache*.whl files
# UV=uv                                         # path to uv
# DSV41_HF_REPO=deepseek-ai/DeepSeek-V4.1-Flash-1017

# --- engine (read by scripts/serve_engine.sh; defaults shown) -------------------------------------------------------
# DSV41_EDIT_LAYERS=12,14-38                    # installed edit slots (0-based layer outputs); never 0, 13 or 39
# DSV41_N_ARMS=16                               # arm slots; arm 0 is the sham and stays all zero
# DSV41_CAPTURE_LAYERS=12,15,18,22,25,26,27,30,34
# DSV41_COEF_ROWS=1048576                       # coefficient capture ring (TP rank 0)
# DSV41_VEC_ROWS=32768                          # vector capture ring (TP rank 0), 5120 bf16 per layer per row
# DSV41_EDIT_IMPL=torch                         # or triton
# DSV41_EAGER=0                                 # 1 = --enforce-eager fallback
# DSV41_MHC_OVERLAP=1                           # 0 = no mHC side stream

# --- tools (defaults shown) -----------------------------------------------------------------------------------------
# DSV41_ENGINE_URL=http://127.0.0.1:8101
